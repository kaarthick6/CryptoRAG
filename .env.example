APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
FRONTEND_API_URL=http://127.0.0.1:8000

COMPLIANCE_DOCUMENTS_PATH=./data/compliance-documents
SQLITE_DATABASE_PATH=./storage/app.db
WHOOSH_INDEX_PATH=./storage/whoosh_index

# Connect to a running Milvus service. Milvus Lite is not supported on Windows.
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=compliance_chunks

EMBEDDING_MODEL=BAAI/bge-large-en
RERANKER_MODEL=BAAI/bge-reranker-base

LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_MODEL=llama-3.1-8b-instant
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

MANIFEST_PATH=./storage/trusted_manifest.json
MANIFEST_SIGNING_KEY=

CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RRF_K=60
MAX_UPLOAD_SIZE_MB=25
